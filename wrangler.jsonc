{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controlledchaos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is what lets web-push (crypto.createECDH + node:https) and
  // node-ical (node:fs) run unchanged — verified against workerd before the
  // migration started, so neither needs a WebCrypto rewrite.
  //
  // global_fetch_strictly_public makes fetch() to our own public hostname go
  // out through the edge instead of looping back inside the Worker. Required
  // by OpenNext.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Wrangler bundles with esbuild's keepNames by default, which rewrites
  // `function f(){}` to `function f(){}; __name(f, "f")`. next-themes ships its
  // pre-paint theme script to the browser via Function.prototype.toString(), so
  // that rewritten source lands in the HTML while the __name helper stays behind
  // in the Worker bundle -> "Uncaught ReferenceError: __name is not defined",
  // and the theme never gets applied. Affects any library that stringifies a
  // function for the client. Needs wrangler >= 4.13.0.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // MUST stay true. Declaring `routes` below flips workers_dev to false on the
  // next deploy unless it is set explicitly — Cloudflare infers it. That
  // disabled controlledchaos.lmdrew.workers.dev, which returned 404 with
  // "error code: 1042", and since the QStash schedules post to that hostname
  // (see scripts/sync-qstash-schedules.ts) every cron tick died silently:
  // no nudges, no digests, no calendar sync, and no error anywhere in the app.
  "workers_dev": true,
  // Declared here because wrangler treats this file as authoritative: a deploy
  // pushes local config over the dashboard's, and a route that only exists in
  // the dashboard gets dropped. Without this entry every deploy warned it was
  // about to detach the custom domain.
  "routes": [
    {
      "pattern": "controlledchaos.adhdesigns.dev",
      "custom_domain": true
    }
  ],
  // The reason for leaving Vercel: Workers Logs is on the paid plan rather
  // than gated behind an Observability upsell.
  "observability": {
    "enabled": true
  }
}
